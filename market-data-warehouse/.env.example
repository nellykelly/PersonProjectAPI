# Copy to .env. run.py auto-loads it. Real env vars always win.

# duckdb (default, no account needed), motherduck, or snowflake
WAREHOUSE_TARGET=duckdb

# RAW landing schema name, shared by the loader and the dbt sources
RAW_SCHEMA=RAW

# --- DuckDB -------------------------------------------------------------
# Defaults to market-data-warehouse/warehouse/market.duckdb. run.py pins
# this to an absolute path so the loader and dbt use the same file.
# DUCKDB_PATH=

# --- MotherDuck (only read when WAREHOUSE_TARGET=motherduck) -----------
# Free "Lite" tier: 10GB storage, 10 Pulse compute-hrs/month, permanent,
# no card. Sign up at motherduck.com, then get a token at
# app.motherduck.com/token. Without MOTHERDUCK_TOKEN set, a bare
# `duckdb.connect("md:...")` opens an interactive browser login instead
# of failing -- this project requires the token explicitly so a script
# never hangs waiting on that.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=market

# --- Snowflake (only read when WAREHOUSE_TARGET=snowflake) -------------
# Values match snowflake/setup.sql. SNOWFLAKE_ACCOUNT is the ORGNAME-ACCOUNTNAME
# that setup.sql's last query prints. Auth is key-pair: generate the key with
# `python tools/snowflake_keygen.py` and put only its PATH here (never the key).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=MARKET_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=S:\.secrets\snowflake\rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback only (a plain password user); leave blank when using the key.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=MARKET_ETL
SNOWFLAKE_WAREHOUSE=MARKET_WH
SNOWFLAKE_DATABASE=MARKET
# schema dbt builds models into (staging/marts/snapshots are created under it)
SNOWFLAKE_DBT_SCHEMA=ANALYTICS
