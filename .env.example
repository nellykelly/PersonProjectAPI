# Copy this file to .env and fill in real values before running locally
# or via docker-compose. Nothing here has a secret default checked into
# git -- see config.py for how each of these is consumed.

FLASK_ENV=development

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Defaults to sqlite:///instance/site.db if unset. docker-compose.yml
# overrides this to point at the postgres service automatically -- set
# it yourself only if you're running `flask run` locally against your
# own Postgres instance. Pipeline World's /pipeline-analytics page
# specifically requires Postgres (its SQL uses DATE_TRUNC + window
# functions); everything else on the site works fine against SQLite.
DATABASE_URL=

# Only read directly if you're running docker-compose (it builds
# DATABASE_URL/REDIS_URL from these + the service names) -- irrelevant
# for local `flask run`, which just uses DATABASE_URL/REDIS_URL above.
POSTGRES_USER=pipelineworld
POSTGRES_PASSWORD=pipelineworld
POSTGRES_DB=pipelineworld

# Redis, for Pipeline World's queue (RQ) and cache-aside world state
# (see app/services/queue.py, world_cache.py). Leave unset for local dev
# without Docker -- falls back to an in-memory fakeredis instance with a
# worker thread inside the web process, so there's still something to
# demo without a real Redis server.
REDIS_URL=

# Leave unset: per-stage delay is a random 1-10s roll by default, or 0
# ("fast mode") toggled at runtime via the button on the Pipeline World
# page -- not an env var. Only set this to force every stage to a fixed
# delay instead, bypassing both the random roll and the fast-mode toggle.
PIPELINE_STAGE_DELAY_SECONDS=
PIPELINE_JOIN_RATE_LIMIT=10 per hour
PIPELINE_FAST_MODE_RATE_LIMIT=30 per hour
WORLD_CACHE_TTL_SECONDS=30

# SEC requires a descriptive User-Agent identifying the requester on
# every data.sec.gov call: https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=PersonProjectAPI-portfolio-site koskela.nelson@gmail.com

# Comma-separated. Leave unset to use the built-in ~45-ticker default
# (see config.py DEFAULT_TICKER_WHITELIST).
TICKER_WHITELIST=

# QR composite score category weights (must be used consistently; any
# combination is fine, they get renormalized if a category is missing
# data for a given company).
QR_WEIGHT_VALUATION=0.25
QR_WEIGHT_LEVERAGE=0.25
QR_WEIGHT_GROWTH=0.25
QR_WEIGHT_PROFITABILITY=0.25

TRADING_MAX_OPEN_POSITIONS_PER_SESSION=10
TRADING_RATE_LIMIT=10 per hour
PRICE_CACHE_TTL_SECONDS=60

RATELIMIT_STORAGE_URI=memory://

# Password gate on /documentation/interview (the interview question bank).
# Store a HASH, never the password -- this repo is public. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
# Leave unset to close the section entirely (it fails closed, never open).
DOCS_PASSWORD_HASH=
DOCS_UNLOCK_RATE_LIMIT=10 per hour

# Password gate on /job-tracker -- Nelson's private job-application
# tracker. Same rules as DOCS_PASSWORD_HASH: store a HASH (this repo is
# public), and leaving it unset closes the section entirely (fails closed,
# returns 503, never open). A separate secret from the docs gate. If you
# set this in docker-compose's .env, double every `$` in the hash to `$$`
# (Compose interpolates `$`); a plain `flask run` reads it literally.
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
JOB_TRACKER_PASSWORD_HASH=
JOB_TRACKER_UNLOCK_RATE_LIMIT=10 per hour
# `flask job-tracker sweep` ghosts applications stuck in "Applied" this
# many weeks (measured from the last status change). Nothing runs it
# automatically -- wire the command to cron.
JOB_TRACKER_GHOST_AFTER_WEEKS=2.5

# Username of the one account the personal AI assistant will take
# job-tracker tool calls from (matched case-insensitively). Unused until
# the assistant ships; leave blank otherwise.
ADMIN_USERNAME=

# Accounts -- username/password login that gates the LeetCode 150 tracker
# so each account keeps its own board. Registration is open by default;
# set REGISTRATION_ENABLED=false to close signups (existing accounts keep
# working, /register returns 403). No email is stored and there is no
# self-serve reset -- use `flask create-user <name>` / `flask set-password
# <name>` from the shell.
REGISTRATION_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10 per hour
AUTH_REGISTER_RATE_LIMIT=5 per hour

# Personal AI assistant (see personal-assistant-build-plan.md). The chat
# model runs on Groq's free tier -- create a key at
# https://console.groq.com  (API Keys -> Create API Key), no credit card.
# The key looks like `gsk_...` (no `$`), so it needs no docker-compose
# `$$` escaping. Unset => the /assistant page renders an "offline" panel
# instead of erroring. Read via os.environ in app/config.py; never commit
# a real value -- .env is gitignored.
GROQ_API_KEY=
# Groq rotates its model catalogue -- if this 404s, list the current ids
# with `client.models.list()` and pick a chat model.
GROQ_MODEL=qwen/qwen3.8-27b
# Model used only for the owner's job-tracker tool calls (needs reliable
# function-calling). Normal chat stays on GROQ_MODEL. Blank => reuse it.
GROQ_TOOL_MODEL=llama-3.3-70b-versatile
# A chat message is a real LLM call against a shared free-tier quota, so
# this is tighter than the site's read-only limits.
ASSISTANT_CHAT_RATE_LIMIT=20 per hour
# Retrieval needs Postgres + pgvector (docker-compose provides it). On a
# plain SQLite `flask run` the assistant falls back to an in-process
# cosine search over the same content_chunks table -- fine for local dev.
# `flask assistant reindex` (re)builds that table from app/assistant_content/.

# ---------------------------------------------------------------------------
# /family -- private household suite (home / calendar / grocery / Hera chat)
# ---------------------------------------------------------------------------
# One shared password gates the whole section. Store a Werkzeug HASH (this
# repo is public); unset => /family returns 503 to everyone (fails closed).
# Contains `$`, so double them (`$$`) if you set this in docker-compose's
# .env; a plain `flask run` reads it literally.
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
FAMILY_PASSWORD_HASH=
FAMILY_UNLOCK_RATE_LIMIT=10 per hour
# The Hera chatbot at /family/chat -- its OWN Groq key, separate from the
# portfolio assistant's. Unset => the chat panel is offline (503); the
# calendar / grocery / home screens still work. FAMILY_GROQ_MODEL must
# support tool calling.
FAMILY_GROQ_API_KEY=
FAMILY_GROQ_MODEL=openai/gpt-oss-120b
FAMILY_CHAT_RATE_LIMIT=60 per hour
# After first deploy: `flask family seed` creates the two members (the
# migration also seeds them); `flask family rename m2 "Sav"` renames one.

# ---------------------------------------------------------------------------
# /projects/market-warehouse -- read-only view over market-data-warehouse/'s
# star schema (a sibling project, its own README/HARDENING.md)
# ---------------------------------------------------------------------------
# Defaults to that project's own local DuckDB output file -- zero-config,
# nothing to set. To point the page at a live MotherDuck database instead
# (see market-data-warehouse/README.md's MotherDuck section), set both:
#   MARKET_WAREHOUSE_DB_PATH=md:market
#   MOTHERDUCK_TOKEN=<same token as market-data-warehouse/.env, or a fresh one>
# MARKET_WAREHOUSE_DB_PATH=
# MOTHERDUCK_TOKEN=
