# Copy this file to .env and fill in real values before running locally
# or via docker-compose. Nothing here has a secret default checked into
# git -- see config.py for how each of these is consumed.

FLASK_ENV=development

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Defaults to sqlite:///instance/site.db if unset. docker-compose.yml
# overrides this to point at the postgres service automatically -- set
# it yourself only if you're running `flask run` locally against your
# own Postgres instance. Pipeline World's /pipeline-analytics page
# specifically requires Postgres (its SQL uses DATE_TRUNC + window
# functions); everything else on the site works fine against SQLite.
DATABASE_URL=

# Only read directly if you're running docker-compose (it builds
# DATABASE_URL/REDIS_URL from these + the service names) -- irrelevant
# for local `flask run`, which just uses DATABASE_URL/REDIS_URL above.
POSTGRES_USER=pipelineworld
POSTGRES_PASSWORD=pipelineworld
POSTGRES_DB=pipelineworld

# Redis, for Pipeline World's queue (RQ) and cache-aside world state
# (see app/services/queue.py, world_cache.py). Leave unset for local dev
# without Docker -- falls back to an in-memory fakeredis instance with a
# worker thread inside the web process, so there's still something to
# demo without a real Redis server.
REDIS_URL=

# Leave unset: per-stage delay is a random 1-10s roll by default, or 0
# ("fast mode") toggled at runtime via the button on the Pipeline World
# page -- not an env var. Only set this to force every stage to a fixed
# delay instead, bypassing both the random roll and the fast-mode toggle.
PIPELINE_STAGE_DELAY_SECONDS=
PIPELINE_JOIN_RATE_LIMIT=10 per hour
PIPELINE_FAST_MODE_RATE_LIMIT=30 per hour
WORLD_CACHE_TTL_SECONDS=30

# SEC requires a descriptive User-Agent identifying the requester on
# every data.sec.gov call: https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=PersonProjectAPI-portfolio-site koskela.nelson@gmail.com

# Comma-separated. Leave unset to use the built-in ~45-ticker default
# (see config.py DEFAULT_TICKER_WHITELIST).
TICKER_WHITELIST=

# QR composite score category weights (must be used consistently; any
# combination is fine, they get renormalized if a category is missing
# data for a given company).
QR_WEIGHT_VALUATION=0.25
QR_WEIGHT_LEVERAGE=0.25
QR_WEIGHT_GROWTH=0.25
QR_WEIGHT_PROFITABILITY=0.25

TRADING_MAX_OPEN_POSITIONS_PER_SESSION=10
TRADING_RATE_LIMIT=10 per hour
PRICE_CACHE_TTL_SECONDS=60

RATELIMIT_STORAGE_URI=memory://

# Password gate on /documentation/interview (the interview question bank).
# Store a HASH, never the password -- this repo is public. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
# Leave unset to close the section entirely (it fails closed, never open).
DOCS_PASSWORD_HASH=
DOCS_UNLOCK_RATE_LIMIT=10 per hour

# Accounts -- username/password login that gates the LeetCode 150 tracker
# so each account keeps its own board. Registration is open by default;
# set REGISTRATION_ENABLED=false to close signups (existing accounts keep
# working, /register returns 403). No email is stored and there is no
# self-serve reset -- use `flask create-user <name>` / `flask set-password
# <name>` from the shell.
REGISTRATION_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10 per hour
AUTH_REGISTER_RATE_LIMIT=5 per hour
