# Caddy automatically requests, installs, and renews a Let's Encrypt
# certificate for every domain listed as a site address below -- no
# manual certbot/cron setup. `reverse_proxy` forwards everything to the
# `web` container by its compose service name, over the internal Docker
# network (not the public internet), on the port it actually listens on.

# www.nelsonkoskela.dev is deliberately left out: it currently falls
# through a wildcard CNAME (*.nelsonkoskela.dev -> pixie.porkbun.com,
# Porkbun's parking page) since there's no dedicated `www` A record --
# requesting a cert covering both domains in one order meant www's
# failure dragged the whole order down and tripped Caddy's Let's
# Encrypt staging-CA fallback. Add www back here once a real `www` A
# record pointing at this server exists.
nelsonkoskela.dev {
    reverse_proxy web:8000
}
