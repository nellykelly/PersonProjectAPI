# Caddy automatically requests, installs, and renews a Let's Encrypt
# certificate for every domain listed as a site address below -- no
# manual certbot/cron setup. `reverse_proxy` forwards everything to the
# `web` container by its compose service name, over the internal Docker
# network (not the public internet), on the port it actually listens on.

nelsonkoskela.dev, www.nelsonkoskela.dev {
    # Static assets served directly off disk instead of proxied to the
    # app -- gunicorn runs as a single process with only 8 threads total
    # (see Dockerfile, -w 1 --threads 8: deliberately one process so
    # Flask-SocketIO sessions stay in one process's memory), shared
    # across every dynamic route, every open live-view SSE connection
    # (watchlist, network sniffer), AND every one of the ~15-20 static
    # requests a single page load fires off. That made even a static CSS
    # or font file queue behind whatever else that thread pool was doing,
    # a real multi-second bottleneck on every load, not just a cold-cache
    # first visit. Caddy's file_server has no such limit and serves these
    # with proper Last-Modified/ETag conditional-GET support on its own,
    # off the app process entirely. `docker-compose.yml` mounts
    # ./app/static read-only into this container at /srv/static so the
    # path matches what the app itself serves at /static/*.
    handle_path /static/* {
        root * /srv/static
        file_server
        # no-cache, not max-age: these filenames carry no content hash, so
        # nothing about a deploy tells a browser its copy is stale. With
        # max-age=3600 a visitor kept running the previous JS for up to an
        # hour after a fix shipped -- observed directly, debugging a
        # collision fix against a cached copy of the old file.
        #
        # "no-cache" does not mean "do not store". The browser keeps the
        # file and revalidates with If-None-Match; Caddy answers 304 from
        # the ETag it already sends, so unchanged assets cost one small
        # conditional request instead of a re-download. The reason this
        # block exists -- keeping asset serving off gunicorn's 8-thread
        # pool -- is unaffected, since Caddy still answers entirely from
        # disk.
        header Cache-Control "no-cache"
    }

    reverse_proxy web:8000
}
